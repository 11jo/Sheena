	Delay(30)
	!AreaCheck("AR1202")
	InParty(Myself)
	InParty("K#Sheena")
	Global("SheenaTalkNalia","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("SheenatalkNalia","GLOBAL",1)
//		Wait(5)
		Interact("K#Sheena")
END
