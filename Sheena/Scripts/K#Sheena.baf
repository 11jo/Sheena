//////////////////////////////////////////////////////////////////////////////
//PART I: CONTROLS THE POLYMORPHING ABILITIES OF SHEENA
//////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////
//IMPORTANT SCRIPTING VARIABLE
//SheenRHD - Dragon form = 1 Human form = 0
//K#BENAB - Abiltity button enabled = 1 Disabled = 0
//UnlockPolyHD - PC in control of Sheena porlymorph = 1 Not in control = 0
//////////////////////////////////////////////////////////////////////////////
//This will trigger the next morning slept with Sheena talk
//SetGlobal SheenaLoveTalk is done through BSheena
//Triggering of SLT10 is done through the K#SheenD script
//It is placed front to be triggered faster
IF
  Global("K#SheenaSleptWithPC","GLOBAL",1)
  Global("SheenaRomanceActive","GLOBAL",2)
  Global("SheenaMakeRain","LOCALS",2)
  CombatCounter(0)
  Global("SheenaLoveTalk","LOCALS",11)
THEN
  RESPONSE #100
    IncrementGlobal("SheenaLoveTalk","LOCALS",1)
    Interact(Player1)
END

//IF DIE AND WE HAVE PERFORMED THE RITUAL KILL PLAYER1 - END OF GAME
IF 
Global("SHEENAPCAREONE","GLOBAL",1)
Die()
THEN
RESPONSE #100
ActionOverride(Myself,Kill(Player1))
END

//IF DIES IN HALF DRAGON FORM
//Actually the spell only changes the ability to change back to Dragon form
//if she died in such form and restores her human form and portrait
//IF 
//Global("SheenRHD","GLOBAL",1)
//Die()
//Global("K#Died","GLOBAL",0)
//THEN
//RESPONSE #100
//ActionOverride(Myself,ApplySpellRES("K#POLYS1",Myself))
//SetGlobal("K#Died","GLOBAL",1)
//END
//The spells now use permanent after death. So she'll always die in the form
//she last attired. No need for it any longer

//These 4 next blocks of script are meant to debug the imprisonment spell
//If Sheena was imprisoned in half dragon form she could no longer rejoin when freed
IF 
!InParty("K#Sheena")
Global("SheenRHD","GLOBAL",1)
Global("SheenaJoined","GLOBAL",1)
Global("K#Died","GLOBAL",1)
THEN
RESPONSE #100
SetGlobal("K#Died","GLOBAL",0)
ApplySpellRES("K#POLYB","K#Sheena")
JoinParty()
END

IF 
!InParty("K#Sheena")
Global("SheenRHD","GLOBAL",0)
Global("SheenaJoined","GLOBAL",1)
Global("K#Died","GLOBAL",1)
THEN
RESPONSE #100
SetGlobal("K#Died","GLOBAL",0)
JoinParty()
END

IF 
Global("K#Died","GLOBAL",1)
!Dead("K#Sheena")
Global("SheenaJoined","GLOBAL",1)
THEN
RESPONSE #100
SetGlobal("K#Died","GLOBAL",0)
END

IF 
	OR(2)
		!InParty("K#Sheena")
		!InParty(Myself)
	Global("SheenaJoined","GLOBAL",1)
	Global("K#SheenaOut","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("K#SheenaOut","GLOBAL",1)
		SetLeavePartyDialogFile()
END

//SHEENA FIRST MEETING - POLYMORPHS INTO HUMAN WHEN FIRKRAAG DIES
IF 
Global("KH#SheenaExists","LOCALS",1)
Global("FirstForm","LOCALS",0)
!See(Player1)
THEN
RESPONSE #100
SetGlobal("FirstForm","LOCALS",1)
ApplySpellRES("K#POLYS",Myself)
END

IF 
	Global("KH#SheenaExists","LOCALS",1)
	Global("FirstForm","LOCALS",1)
	Global("SPRITE_IS_DEADFIRKRA02","GLOBAL",1)
	OR(6)
		Detect(Player1)
		Detect(Player2)
		Detect(Player3)
		Detect(Player4)
		Detect(Player5)
		Detect(Player6)
THEN
	RESPONSE #100
		SetGlobal("KH#SheenaExists","LOCALS",2)
		SetGlobal("FirstForm","LOCALS",2)
		ApplySpellRES("K#POLYB",Myself)
END

//SHEENA POLYMORPH SCRIPT
//IF IN HALF DRAGON FORM IN A CITY, POLYMORPH INTO HUMAN AND DISABLE BUTTON
IF
	Global("SheenRHD","GLOBAL",1)//Sheena is in dragon form
	Global("K#BENAB","GLOBAL",1)//Ability button is enabled
	Global("UnlockPolyHD","GLOBAL",0)//The PC is not in control of Sheenas form
	InParty(Myself)
	OR(4)
		AreaType(CITY)
		AreaType(FOREST)
		AreaCheck("AR1100")
		AreaCheck("AR1204")
THEN
	RESPONSE #100
		ApplySpellRES("K#DSABLE",Myself) //Disable ability button
		ApplySpellRES("K#POLYB", Myself) //Change into a human form
		RemoveSpellRES("K#REDDRA")
END

IF
 Global("SheenRHD","GLOBAL",0)//Sheena is in human form
 Global("SheenABI","GLOBAL",1)//We just polymorphed back
THEN
RESPONSE #100
 SetGlobal("SheenABI","GLOBAL",0)
 RemoveSpellRES("K#REDDRA")
END

//DISABLE POLYMORPH IF LOOK LIKE DROW - KEEP THE ILLUSION GOING
IF
	Global("PlayerLooksLikeDrow","GLOBAL",1)//The illusion started
	Global("SheenaLookLikeDrow","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("SheenaLookLikeDrow","GLOBAL",1)
		ApplySpellRES("K#DSABLE",Myself) //Disable ability button
END

//Remove spell ability: change into HD if I am an HD already
IF
Global("SheenRHD","GLOBAL",1)//HD form
PartyRested()
THEN
RESPONSE #100
RemoveSpellRES("K#POLYS")
RemoveSpellRES("K#POLYS")
RemoveSpellRES("K#REDDRA")
END

//Arrival in Hell counts as rest
IF
Global("SheenRHD","GLOBAL",1)//HD form
AreaCheck("AR2900")//Hell
Global("k#HellBugFix","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("k#HellBugFix","GLOBAL",1)
RemoveSpellRES("K#POLYS")
RemoveSpellRES("K#POLYS")
RemoveSpellRES("K#REDDRA")
END

//Remove spell ability: change into human if I am a human already
IF
Global("SheenRHD","GLOBAL",0)//Human form
PartyRested()
THEN
RESPONSE #100
RemoveSpellRES("K#POLYB")
RemoveSpellRES("K#POLYB")
RemoveSpellRES("K#REDDRA")
END

IF
Global("SheenRHD","GLOBAL",0)//Human form
AreaCheck("AR2900")//Hell
Global("k#HellBugFix","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("k#HellBugFix","GLOBAL",1)
RemoveSpellRES("K#POLYB")
RemoveSpellRES("K#POLYB")
RemoveSpellRES("K#REDDRA")
END


//Adalon place specific polymorph to initiate dialog
IF
Global("SheenRHD","GLOBAL",0)
AreaCheck("AR2102")
!Global("StartsSoon","GLOBAL",1)
!Global("PlayerLooksLikeDrow","GLOBAL",1)
THEN
RESPONSE #100
ApplySpellRES("K#POLYS",Myself)
END


//FIXING SHEENA WITH A HOTKEY
IF
	HotKey(S)
THEN
	RESPONSE #100
		ActionOverride(Myself,StartCutScene("K#SheFix"))
END


//IF IN HALF DRAGON FORM IN A CITY, POLYMORPH INTO HUMAN AND DISABLE BUTTON
IF
	Global("SheenRHD","GLOBAL",1) //Sheena is in dragon form
	Global("K#BENAB","GLOBAL",0) //Ability button is disabled
	InParty(Myself)
	Global("UnlockPolyHD","GLOBAL",0) //The PC is not in control of Sheenas form
	OR(5)
		AreaType(CITY)
		AreaType(FOREST)
		AreaCheck("AR1100")
		AreaCheck("AR1204")
		AreaCheck("AR2300") //For the shark king interjection
THEN
	RESPONSE #100
		Wait(2)
		RemoveSpellRES("K#REDDRA")
		ApplySpellRES("K#DSABLE",Myself) //Disable ability button
		ApplySpellRES("K#POLYB", Myself) //Change into a human form
 END


//IF IN HUMAN FORM IN A CITY, DISABLE INNATE ABILITY BUTTON
IF
	Global("SheenRHD","GLOBAL",0) //Sheena in human form
	Global("K#BENAB","GLOBAL",1) //Ability button enabled
	Global("UnlockPolyHD","GLOBAL",0) //The PC is not in control of Sheenas form
	InParty(Myself)
	OR(4)
		AreaType(CITY)
		AreaType(FOREST)
		AreaCheck("AR1100")
		AreaCheck("AR1204")
THEN
	RESPONSE #100
//DISABLE INNATE ABBILITY BUTTON
		ApplySpellRES("K#DSABLE",Myself) //Disable ability button
END

//IF OUTSIDE A CITY, ENABLE THE INNATE ABILITY BUTTON
IF
 Global("SheenRHD","GLOBAL",0)//Sheena in human form
 Global("K#BENAB","GLOBAL",0)//Ability button disabled
 InParty(Myself)
 !AreaType(CITY) 
 !AreaCheck("AR1100")
 !AreaType(FOREST)
 !AreaCheck("AR1204")
!Global("PlayerLooksLikeDrow","GLOBAL",1)//Drow illusion off
 THEN
 RESPONSE #100
 //ENABLE INNATE ABBILITY BUTTON
ApplySpellRES("K#ENABLE",Myself) //Enable ability button
RemoveSpellRES("K#REDDRA") //Remove the ability
 END


//END OF POLYMORPH SCRIPT

//AFTER TALK 5 - ENABLE PERMANENTLY OPTION FOR THE PC TO HAVE SHEENA AS HRD
//DISABLED AND VOID
IF
 Global("K#BENAB","GLOBAL",0)//Ability button Disabled
 Global("UnlockPolyHD","GLOBAL",1)//The PC is now in control of Sheenas form
 !Global("PlayerLooksLikeDrow","GLOBAL",1)
THEN
 RESPONSE #100
 //ENABLE INNATE ABBILITY BUTTON
ApplySpellRES("K#ENABLE",Myself) //Enable ability button
END

//////////////////////////////////////////////////////
//PART II: PC DIALOG START
IF
 Global("SheenaMatch","GLOBAL",0)
 Global("CheckSheenaMatch","GLOBAL",0)
 //NO RACIAL AND GENDER ABUSES
 THEN
 RESPONSE #100
  SetGlobal("CheckSheenaMatch","GLOBAL",1)
  SetGlobal("SheenaMatch","GLOBAL",1)
  SetGlobal("SheenaTalk","LOCALS",1)
  RealSetGlobalTimer("SheenaTalkTime","GLOBAL",900)//Fifteen minutes
END

//Start the rain for Lovetalk 10
//RestParty will trigger SheenaD.bcs file
//thus triggering the lovetalk
IF
  !Dead("K#Sheena")
  !Global("SheenaRomanceActive","GLOBAL",0)
  !Global("SheenaRomanceActive","GLOBAL",3)
  Global("SheenaMatch","GLOBAL",1)
  AreaType(FOREST)
  AreaType(OUTDOOR)
  Global("SheenaLovetalk","LOCALS",9)
  Global("SheenaMakeRain","LOCALS",0)
THEN
  RESPONSE #100
  SetGlobal("SheenaMakeRain","LOCALS",1)
  RealSetGlobalTimer("SheenaMakeRain","GLOBAL",12)
  ActionOverride(Myself,Weather(RAIN))//Takes about 10 seconds to trigger
END

IF
  RealGlobalTimerExpired("SheenaMakeRain","GLOBAL")
  Global("SheenaMakeRain","LOCALS",1)
THEN
  RESPONSE #100
  SetGlobal("SheenaMakeRain","LOCALS",2)
  RestParty()//Triggers lovetalk10 without waiting
END


IF
	InParty(Myself)
	RealGlobalTimerExpired("SheenaTalkTime","GLOBAL")
	Global("SheenaMatch","GLOBAL",1)
	!AreaType(DUNGEON)
	See(Player1)
	CombatCounter(0)
	OR(10)
		Global("SheenaTalk","LOCALS",1)
		Global("SheenaTalk","LOCALS",3)
		Global("SheenaTalk","LOCALS",5)
		Global("SheenaTalk","LOCALS",7)
		Global("SheenaTalk","LOCALS",9)
		Global("SheenaTalk","LOCALS",11)
		Global("SheenaTalk","LOCALS",13)
		Global("SheenaTalk","LOCALS",15)
		Global("SheenaTalk","LOCALS",17)
		Global("SheenaTalk","LOCALS",19)
THEN
	RESPONSE #100
		IncrementGlobal("SheenaTalk","LOCALS",1)
		Interact(Player1)
END

IF
	InParty(Myself)
	RealGlobalTimerExpired("SheenaTalkTime","GLOBAL")
	Global("SheenaMatch","GLOBAL",1)
	OR(10)
		Global("SheenaTalk","LOCALS",2)
		Global("SheenaTalk","LOCALS",4)
		Global("SheenaTalk","LOCALS",6)
		Global("SheenaTalk","LOCALS",8)
		Global("SheenaTalk","LOCALS",10)
		Global("SheenaTalk","LOCALS",12)
		Global("SheenaTalk","LOCALS",14)
		Global("SheenaTalk","LOCALS",16)
		Global("SheenaTalk","LOCALS",18)
		Global("SheenaTalk","LOCALS",20)
THEN
	RESPONSE #100
		RealSetGlobalTimer("SheenaTalkTime","GLOBAL",3600) //1 HOUR
		IncrementGlobal("SheenaTalk","LOCALS",1)
END

//Romance - Love talk start here
IF
 Global("SheenaMatch","GLOBAL",1)
 Global("CheckSheenaMatch","GLOBAL",1)
 Global("SheenaRomanceActive","GLOBAL",0)
 Gender(Player1,MALE)
 Global("SheenaTalk","LOCALS",21)//End of friendship track
 !Global("ViconiaRomanceActive","GLOBAL",2)
 !Global("AerieRomanceActive","GLOBAL",2)
 !Global("JaheiraRomanceActive","GLOBAL",2)
 THEN
 RESPONSE #100
  SetGlobal("SheenaRomanceActive","GLOBAL",2)
  SetGlobal("SheenaMatch","GLOBAL",1)
  SetGlobal("SheenaLoveTalk","LOCALS",1)
  RealSetGlobalTimer("SheenaLoveTalkTime","GLOBAL",3600)//1 hOUR
END

IF
	InParty(Myself)
	RealGlobalTimerExpired("SheenaLoveTalkTime","GLOBAL")
	Global("SheenaMatch","GLOBAL",1)
	Global("SheenaRomanceActive","GLOBAL",2)
	!AreaType(DUNGEON)
	See(Player1)
	CombatCounter(0)
	OR(5)
		Global("SheenaLoveTalk","LOCALS",1)
		Global("SheenaLoveTalk","LOCALS",3)
		Global("SheenaLoveTalk","LOCALS",5)
		Global("SheenaLoveTalk","LOCALS",7)
		Global("SheenaLoveTalk","LOCALS",13)
THEN
	RESPONSE #100
		PlaySong(0)
		IncrementGlobal("SheenaLoveTalk","LOCALS",1)
		Interact(Player1)
END

IF
	InParty(Myself)
	RealGlobalTimerExpired("SheenaLoveTalkTime","GLOBAL")
	Global("SheenaMatch","GLOBAL",1)
	Global("SheenaRomanceActive","GLOBAL",2)
	OR(5)
		Global("SheenaLoveTalk","LOCALS",2)
		Global("SheenaLoveTalk","LOCALS",4)
		Global("SheenaLoveTalk","LOCALS",6)
		Global("SheenaLoveTalk","LOCALS",8)
		Global("SheenaLoveTalk","LOCALS",14)
THEN
	RESPONSE #100
		RealSetGlobalTimer("SheenaLoveTalkTime","GLOBAL",3600) //1 HOUR
		IncrementGlobal("SheenaLoveTalk","LOCALS",1)
END

//Flirt OFF
