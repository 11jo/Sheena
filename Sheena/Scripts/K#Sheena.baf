//ADD XP
IF 
XPLT(Player1,500000)//
Global("KH#SheenaExists","LOCALS",2)
THEN
RESPONSE #100
SetGlobal("KH#SheenaExists","LOCALS",3)
END

IF 
XPGT(Player1,500000)//500001
XPLT(Player1,1000000)//999999
Global("KH#SheenaExists","LOCALS",2)
THEN
RESPONSE #100
SetGlobal("KH#SheenaExists","LOCALS",3)
AddXPObject(Myself,400000)
END

IF 
XPGT(Player1,999999)//
XPLT(Player1,1500000)//
Global("KH#SheenaExists","LOCALS",2)
THEN
RESPONSE #100
SetGlobal("KH#SheenaExists","LOCALS",3)
AddXPObject(Myself,1000000)
END

IF 
XPGT(Player1,1500000)//
Global("KH#SheenaExists","LOCALS",2)
THEN
RESPONSE #100
SetGlobal("KH#SheenaExists","LOCALS",3)
AddXPObject(Myself,1500000)
END

//IF ENEMY - PC BETRAYED ADALON
//SCRIPT FOR SIDING WITH ADALON
IF 
AreaCheck("AR2102")
Allegiance(Myself,ENEMY)
Global("K#BUFF","LOCALS",0)
THEN
RESPONSE #100
SetGlobal("K#BUFF","LOCALS",1)
SetGlobalTimer("K#CastSpell","LOCALS",6)
DisplayString(Myself,40252)
ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_NECROMANCY)
ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)
ReallyForceSpell(Myself,WIZARD_SPELL_SHIELD)
ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)
END

IF
	Allegiance(Myself,ENEMY)
	ActionListEmpty()
	OR(5)
		See(NearestEnemyOf(Myself))
		See([PC.0.0.CLERIC_ALL])
		See([PC.0.0.MAGE_ALL])
		See(WorstAC)
		See(MostDamagedOf(Myself))
	AreaCheck("AR2102")
	!Allegiance(LastSeenBy(Myself),ENEMY)
THEN
	RESPONSE #100
		EquipMostDamagingMelee()
		AttackReevaluate(LastSeenBy(Myself),15)
END

//SEEK OUT THE BHAALSPAWN
IF
  Allegiance(Myself,Enemy)
  AreaCheck("AR2102")
  !See([PC])
   Detect([PC])
THEN
  RESPONSE #100
	MoveToObject(Player1)    
END

//Debug join for version 3 players upgrading to version 5
IF
InParty(Myself)
Global("SheenaJoined","GLOBAL",0)
THEN
  RESPONSE #100
SetGlobal("SheenaJoined","GLOBAL",1)
END
