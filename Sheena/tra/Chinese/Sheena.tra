/*汉化 by anca_qin*/

//Fixing script
@1 = ~希娜~
@2 = ~天哪！总算有人有足够的力量结束这种疯狂！拜托你，能把我从牢笼里放出来吗，好心的<PRO_SIRMAAM>？~
@3 = ~当问起她的过去，希娜说养父是她过去唯一承认是自己父亲的人。~
@4 = ~你不会伤害一位姑娘吧？~ [Female28] //Battlecry2
@5 = ~在我的领导下每个人都会有好处的。~ [Female2b] //leader
@6 = ~哦，你知道我真的需要休息一下。~ [Female2c] //Tired
@7 = ~我们这样无所事事，我们做点什么吧。~ [Female2d] //Bored
@8 = ~我的伤口需要处理一下。~ [Female2e] //Damage
@9 = ~嗯~ [Female2f] //Select1
@10 = ~我听你的。~ [Female2g] //selct2
@11 = ~是。~ [Female2h] //selct3
@12 = ~没问题。~ [Female2i] //Action1
@13 = ~很好。~ [Female2j] //action2
@14 = ~你究竟想要什么。~ [Female2k] //action3
@15 = ~呃~ [Female2l] //Hurt
@16 = ~~ [Female2m] //Dying 
@17 = ~~ [Female2n]//Forest - do not exist
@18 = ~~ [Female2o]//City - do not exist
@19 = ~~ [Female2p]//Dungeon - do not exist
@20 = ~~ [Female2q]//Day - do not exist
@21 = ~~ [Female2r]//Night - do not exist
@22 = ~如果你那样说。~ [Female2s] //action4
@23 = ~当然~ [Female2t] //action5
@24 = ~如果那是你希望的。~ [Female2u] //action6
@25 = ~悉听尊便。~ [Female2v] //action7
@26 = ~99200~
@27 = ~你喜欢什么？~ [Female2x] //rare1
@28 = ~告诉我关于它的事。~ [Female2y] //rare2
@29 = ~痛不痛？~ [Female2z] //Critical hit
@30 = ~啊！你这个疯狂的杂种！~ [Female21] //miss
@31 = ~我的攻击没有效果吗？~ [Female22] //target immune
@32 = ~我只是无法携带更多的东西了，你替我把那个捡起来好吗？~ [Female23] //Inventory full
